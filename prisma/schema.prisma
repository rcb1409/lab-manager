datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Lab {
  id                 String          @id @default(uuid())
  name               String
  building           String
  room               String
  description        String?         @db.Text
  imageUrl           String?
  bookingWindowStart String?         // HH:MM e.g. "09:00"
  bookingWindowEnd   String?         // HH:MM e.g. "17:00"
  bookingDays        String?         // comma-separated 0=Sun…6=Sat; null = all days
  equipment          Equipment[]
  labAccesses        LabAccess[]
  accessRequests     AccessRequest[]
}

model Equipment {
  id                  String            @id @default(uuid())
  labId               String
  name                String
  type                String
  description         String?           @db.Text
  imageUrl            String?
  qrCodeUrl           String?
  status              EquipmentStatus   @default(AVAILABLE)
  googleCalendarId    String?
  onboardingRequired  Boolean           @default(false)
  onboardingMaterials String?           @db.Text
  bookingWindowStart  String?           // HH:MM — overrides lab window when set
  bookingWindowEnd    String?
  bookingDays         String?           // comma-separated 0=Sun…6=Sat; null = all days
  lab                 Lab               @relation(fields: [labId], references: [id], onDelete: Cascade)
  usageLogs           UsageLog[]
  bookings            Booking[]
  equipmentAccesses   EquipmentAccess[]
  accessRequests      AccessRequest[]
}

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
}

model User {
  id                    String            @id @default(uuid())
  name                  String?
  email                 String            @unique
  emailVerified         DateTime?
  image                 String?
  role                  Role              @default(USER)
  accounts              Account[]
  sessions              Session[]
  usageLogs             UsageLog[]
  bookings              Booking[]
  labAccesses           LabAccess[]
  equipmentAccesses     EquipmentAccess[]
  accessRequests        AccessRequest[]
  grantedLabAccesses    LabAccess[]       @relation("LabAccessGrantedBy")
  grantedEquipAccesses  EquipmentAccess[] @relation("EquipmentAccessGrantedBy")
  resolvedAccessReqs    AccessRequest[]   @relation("AccessRequestResolvedBy")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  USER
  ADMIN
}

model UsageLog {
  id             String    @id @default(uuid())
  equipmentId    String
  userId         String
  startTime      DateTime
  endTime        DateTime?
  notes          String?   @db.Text
  googleEventId  String?
  equipment      Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Booking {
  id             String        @id @default(uuid())
  equipmentId    String
  userId         String
  requestedStart DateTime
  requestedEnd   DateTime
  reason         String?       @db.Text
  status         BookingStatus @default(PENDING)
  approvedById   String?
  googleEventId  String?
  equipment      Equipment     @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum BookingStatus {
  PENDING
  APPROVED
  DENIED
}

model LabAccess {
  id          String   @id @default(uuid())
  userId      String
  labId       String
  grantedById String?
  grantedAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab         Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  grantedBy   User?    @relation("LabAccessGrantedBy", fields: [grantedById], references: [id])

  @@unique([userId, labId])
}

model EquipmentAccess {
  id          String    @id @default(uuid())
  userId      String
  equipmentId String
  grantedById String?
  grantedAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  grantedBy   User?     @relation("EquipmentAccessGrantedBy", fields: [grantedById], references: [id])

  @@unique([userId, equipmentId])
}

model AccessRequest {
  id           String              @id @default(uuid())
  userId       String
  labId        String?
  equipmentId  String?
  type         AccessRequestType
  status       AccessRequestStatus @default(PENDING)
  message      String?             @db.Text
  requestedAt  DateTime            @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab          Lab?                @relation(fields: [labId], references: [id])
  equipment    Equipment?          @relation(fields: [equipmentId], references: [id])
  resolvedBy   User?               @relation("AccessRequestResolvedBy", fields: [resolvedById], references: [id])
}

enum AccessRequestType {
  LAB
  EQUIPMENT
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  DENIED
}
